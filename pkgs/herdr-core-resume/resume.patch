+
+/// An explicit, one-shot replacement after loss, supplied by the program's integration.
+#[derive(Serialize, Deserialize, JsonSchema, Clone, Debug, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct Resume {
+    pub key: String,
+    pub cwd: String,
+    pub argv: Vec<String>,
+}
+
+impl Resume {
+    pub fn validate(&self) -> Result<(), RpcError> {
+        if self.key.is_empty()
+            || self.key.len() > 512
+            || self.key.chars().any(char::is_control)
+            || self.cwd.len() > 4096
+            || !std::path::Path::new(&self.cwd).is_absolute()
+            || self.cwd.chars().any(char::is_control)
+            || self.argv.is_empty()
+            || self.argv.len() > 64
+            || self.argv[0].is_empty()
+            || self.argv.iter().map(String::len).sum::<usize>() > 8192
+            || self.argv.iter().any(|s| s.chars().any(char::is_control))
+        {
+            return Err(RpcError::invalid_params(
+                "resume needs a key, an absolute cwd and bounded argv without control characters",
+            ));
+        }
+        Ok(())
+    }
+}
+
+impl std::str::FromStr for Resume {
+    type Err = String;
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        let resume: Self = serde_json::from_str(s).map_err(|e| e.to_string())?;
+        resume.validate().map_err(|e| e.message)?;
+        Ok(resume)
+    }
+}

