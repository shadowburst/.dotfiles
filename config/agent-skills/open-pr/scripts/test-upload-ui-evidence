#!/usr/bin/env bash
set -euo pipefail

script="$(dirname "$0")/upload-ui-evidence"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/bin"

cat >"$tmp/bin/gh" <<'EOF'
#!/usr/bin/env bash
if [[ "$1 $2" == "pr view" ]]; then
  printf '%s\n' "$GH_BODY"
  exit 0
fi
printf '%q ' "$@" >>"$CALLS/gh"
printf '\n' >>"$CALLS/gh"
while (($#)); do
  if [[ "$1" == --body-file ]]; then cp "$2" "$CALLS/body"; fi
  shift
done
exit "${GH_EDIT_EXIT:-0}"
EOF

cat >"$tmp/bin/cup" <<'EOF'
#!/usr/bin/env bash
printf '%q ' "$@" >>"$CALLS/cup"
printf '\n' >>"$CALLS/cup"
if [[ "$1" == attach && "$3" == *fail* ]]; then exit 1; fi
EOF
chmod +x "$tmp/bin/gh" "$tmp/bin/cup"

export PATH="$tmp/bin:$PATH"
export CALLS="$tmp/calls"
mkdir "$CALLS"
touch "$tmp/after.png" "$tmp/demo.mp4"
export GH_BODY=$'## What Changed\n\nCheckout validation.\n\n## UI Changes\n\nErrors now appear inline.\n\n## Checklist\n\n- [x] Evidence'

"$script" --pr 42 --clickup CU-7 \
  --file "$tmp/after.png#Inline checkout validation" \
  --file "$tmp/demo.mp4#Validation interaction"

grep -Fq '<!-- upload-ui-evidence:start -->' "$CALLS/body"
grep -Fq "![Inline checkout validation]($tmp/after.png)" "$CALLS/body"
grep -Fq $'Validation interaction\n\n![]('"$tmp/demo.mp4"')' "$CALLS/body"
python3 - "$CALLS/body" <<'PY'
from pathlib import Path
import sys
body = Path(sys.argv[1]).read_text()
assert body.index("Errors now appear inline.") < body.index("<!-- upload-ui-evidence:start -->")
assert body.index("<!-- upload-ui-evidence:end -->") < body.index("## Checklist")
assert body.count("<!-- upload-ui-evidence:start -->") == 1
PY
grep -Fq -- "--attach $tmp/after.png#Inline\\ checkout\\ validation" "$CALLS/gh"
grep -Fq -- "--attach $tmp/demo.mp4" "$CALLS/gh"
[[ $(grep -c '^attach ' "$CALLS/cup") == 2 ]]
[[ $(grep -c '^comment ' "$CALLS/cup") == 2 ]]
grep -Fq 'comment CU-7 -m Inline\ checkout\ validation' "$CALLS/cup"
grep -Fq 'comment CU-7 -m Validation\ interaction' "$CALLS/cup"

export GH_BODY="$(<"$CALLS/body")"
rm -f "$CALLS/body"
"$script" --pr 42 --file "$tmp/after.png#Updated state"
[[ $(grep -c '<!-- upload-ui-evidence:start -->' "$CALLS/body") == 1 ]]
grep -Fq "![Updated state]($tmp/after.png)" "$CALLS/body"
! grep -Fq 'Inline checkout validation' "$CALLS/body"

: >"$CALLS/cup"
touch "$tmp/fail.png"
set +e
"$script" --pr 42 --clickup CU-7 \
  --file "$tmp/fail.png#Failed upload" \
  --file "$tmp/after.png#Successful upload"
status=$?
set -e
[[ $status == 1 ]]
[[ $(grep -c '^attach ' "$CALLS/cup") == 2 ]]
! grep -Fq 'comment CU-7 -m Failed\ upload' "$CALLS/cup"
grep -Fq 'comment CU-7 -m Successful\ upload' "$CALLS/cup"

export GH_EDIT_EXIT=1
: >"$CALLS/cup"
if "$script" --pr 42 --clickup CU-7 --file "$tmp/after.png#State"; then
  echo 'expected GitHub failure to fail overall' >&2
  exit 1
fi
unset GH_EDIT_EXIT
grep -Fq "attach CU-7 $tmp/after.png" "$CALLS/cup"

export GH_BODY=$'## What Changed\n\nNo UI section.'
: >"$CALLS/gh"
: >"$CALLS/cup"
if "$script" --pr 42 --clickup CU-7 --file "$tmp/after.png#State"; then
  echo 'expected missing UI Changes section to fail' >&2
  exit 1
fi
[[ ! -s "$CALLS/gh" ]]
[[ ! -s "$CALLS/cup" ]]

export GH_BODY=$'## UI Changes\n\nNarrative.'
if "$script" --pr 42 --file "$tmp/after.png#   "; then
  echo 'expected a blank description to fail' >&2
  exit 1
fi

printf 'upload-ui-evidence checks passed\n'
