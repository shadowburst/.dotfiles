{
  "url": "https://studioform-library.webflow.io/demo-request-form",
  "viewport": { "width": 1280, "height": 720 },
  "steps": [
    { "action": "click", "selector": "a[href=\"#DRF-2\"]" },
    { "action": "type", "selector": "#demo_request_form_2 [name=\"Full-Name\"]", "text": "Alex Demo" },
    { "action": "type", "selector": "#demo_request_form_2 [name=\"Email\"]", "text": "alex.demo@example.com" },
    { "action": "type", "selector": "#demo_request_form_2 [name=\"Company-Name\"]", "text": "Example Company" },
    { "action": "click", "selector": "#demo_request_form_2 [name=\"Industry\"]" },
    { "action": "press", "key": "t" },
    { "action": "press", "key": "Enter" },
    { "action": "click", "selector": "#demo_request_form_2 [name=\"Product-Name\"]" },
    { "action": "press", "key": "c" },
    { "action": "press", "key": "Enter" },
    { "action": "click", "selector": "#demo_request_form_2 label:has(input[name=\"Intended-Use\"][value=\"Innovation\"])" },
    { "action": "type", "selector": "#demo_request_form_2 [name=\"Comments\"]", "text": "I'd like to learn how the platform can support our team's workflow." },
    { "action": "click", "selector": "#demo_request_form_2 label:has(input[name=\"Hear-About-Us\"][value=\"Online Search\"])" },
    { "action": "click", "selector": "#demo_request_form_2 [type=\"submit\"]", "expect": "#demo_request_form_2 + .sf-success-message.w-form-done" }
  ]
}
